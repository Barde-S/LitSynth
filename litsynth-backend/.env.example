# ===========================================
# LitSynth Configuration
# Academic Research Assistant Environment
# ===========================================

# ----- LLM Configuration (Perplexity) -----
# Get your API key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ----- Embedding Service (Free Alternative: Sentence Transformers) -----
# No API key needed - uses local Hugging Face models
# Model will be downloaded automatically on first run (~275MB)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# nomic-embed-text-v1.5: 8192 token context, 768 dimensions - ideal for academic papers
# Alternative: bge-small-en-v1.5 (512 tokens, 384 dims)

# ----- Vector Database (ChromaDB - Free & Open Source) -----
# Local persistent storage - no API key needed!
# Data stored locally for privacy and cost savings
CHROMA_PERSIST_DIR=./data/chromadb

# MIGRATION: Pinecone configuration (commented out for rollback)
# ----- Vector Database (Pinecone - Free Tier) -----
# Sign up at: https://www.pinecone.io/ (Free tier: 1 index, 100K vectors)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=litsynth-research-index
# PINECONE_ENVIRONMENT=gcp-starter  # Free tier environment

# ----- OCR Services (For scanned PDFs) -----
# Google Cloud Vision API (Active OCR Provider)
# Sign up at: https://cloud.google.com/vision/docs/setup
# Free tier: 1,000 units/month
# Option 1: Use service account JSON file path
GOOGLE_APPLICATION_CREDENTIALS=./google-vision-credentials.json
# Option 2: Or paste the entire JSON content as a string
# GOOGLE_VISION_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project","private_key":"..."}'

# Adobe PDF Services (OLD - Commented out)
# ADOBE_OCR_CLIENT_ID=your_adobe_client_id
# ADOBE_OCR_CLIENT_SECRET=your_adobe_client_secret

# ILovePDF OCR (OLD - Commented out)
# ILOVEMYPDF_OCR_PUB_KEY=your_ilovepdf_public_key
# ILOVEMYPDF_OCR_SECRET=your_ilovepdf_secret_key

# ----- Application Security -----
LITSYNTH_MASTER_TOKEN=your_secure_master_token_here
LITSYNTH_INSECURE_MODE=False

# ----- Application Settings -----
DEBUG=False
LOG_LEVEL=INFO

# ----- Redis Configuration (for caching) -----
# Local: redis://localhost:6379
# Free cloud option: https://redis.com/try-free/ (30MB free)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Database Configuration -----
# SQLite (default - no setup needed)
DATABASE_URL=sqlite:///./data/db/litsynth.db
